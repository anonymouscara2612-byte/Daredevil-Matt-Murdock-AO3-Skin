  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " 𝔞𝔫 𝔞𝔠𝔱 𝔬𝔣 𝔳𝔦𝔬𝔩𝔢𝔫𝔠𝔢 𝔨𝔢𝔢𝔭𝔰 𝔱𝔥𝔢 𝔰𝔶𝔰𝔱𝔢𝔪 𝔤𝔬𝔦𝔫𝔤 ";
